# Blockchain Network Configuration
# Get your Infura/Alchemy API key from their respective dashboards

# Sepolia Testnet
SEPOLIA_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# or use Alchemy
# SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployer wallet private key (without 0x prefix)
# WARNING: Never commit your real private key!
PRIVATE_KEY=your_wallet_private_key_here

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Coinmarketcap API key for gas reporting (optional)
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Pinata Configuration
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_JWT=

# Network Configuration
PRIVATE_KEY=

# Optional: Other API Keys
ETHERSCAN_API_KEY=
INFURA_API_KEY=
ALCHEMY_API_KEY=
